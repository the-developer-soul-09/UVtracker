<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.UVTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/uv_purple</item>
        <item name="colorPrimaryVariant">@color/uv_orange</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/uv_orange</item>
        <item name="colorSecondaryVariant">@color/uv_red</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Elevation overlays for dark theme -->
        <item name="elevationOverlayEnabled">true</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Card style -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.UVTracker.Splash" parent="Theme.UVTracker">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

</resources>
